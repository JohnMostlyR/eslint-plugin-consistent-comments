{
  "name": "eslint-plugin-consistent-comments",
  "version": "1.4.1",
  "description": "A eslint plugin to format comments in a consistent way.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "comments",
    "formatting",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/JohnMostlyR/eslint-plugin-consistent-comments",
  "bugs": {
    "url": "https://github.com/JohnMostlyR/eslint-plugin-consistent-comments/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnMostlyR/eslint-plugin-consistent-comments.git"
  },
  "license": "MIT",
  "author": "Johan Meester",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "clean": "git clean -xdf .cache dist node_modules",
    "coverage": "vitest run --coverage",
    "format": "prettier --ignore-path .gitignore --write .",
    "debug": "jiti ./debug/test.ts",
    "lint": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@types/eslint": "9.6.1",
    "@types/espree": "^10.1.0",
    "@types/estree": "1.0.8",
    "@types/node": "24.10.4",
    "@vitest/coverage-v8": "4.0.15",
    "eslint": "9.39.1",
    "eslint-plugin-sonarjs": "3.0.5",
    "espree": "11.0.0",
    "glob": "13.0.0",
    "jiti": "^2.6.1",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0",
    "unbuild": "3.6.1",
    "vitest": "4.0.15"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  }
}
