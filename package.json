{
  "name": "eslint-plugin-consistent-comments",
  "version": "1.5.1",
  "description": "A eslint plugin to format comments in a consistent way.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "comments",
    "formatting",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/JohnMostlyR/eslint-plugin-consistent-comments",
  "bugs": {
    "url": "https://github.com/JohnMostlyR/eslint-plugin-consistent-comments/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnMostlyR/eslint-plugin-consistent-comments.git"
  },
  "license": "MIT",
  "author": "Johan Meester",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "clean": "git clean -xdf .cache dist node_modules",
    "coverage": "vitest run --coverage",
    "format": "prettier . --write --list-different",
    "debug": "jiti ./debug/test.ts",
    "lint": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/eslint": "^9.6.1",
    "@types/espree": "^11.1.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-plugin-sonarjs": "^3.0.7",
    "espree": "^11.2.0",
    "glob": "^13.0.6",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  }
}
